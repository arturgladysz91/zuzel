<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.7.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoreSim\CoreSim.csproj" />
    <Compile Include="../../tools/race-engine-readiness/OrderEvidence.cs" Link="Readiness/OrderEvidence.cs" />
    <Compile Include="../../tools/race-engine-readiness/Exact.cs" Link="Readiness/Exact.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\calibration\pge\v1\**\*"
          Link="data\calibration\pge\v1\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\calibration\longitudinal-speed-envelope-before.json"
          Link="docs\calibration\longitudinal-speed-envelope-before.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\calibration\continuous-corner-envelope-impact.md"
          Link="docs\calibration\continuous-corner-envelope-impact.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\calibration\motoarena-matched-venue.md"
          Link="docs\calibration\motoarena-matched-venue.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\calibration\real-start-telemetry.md"
          Link="docs\calibration\real-start-telemetry.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
